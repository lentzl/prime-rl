    "repeated_failure": "E1 simultaneously removes child-send syntax control and exact passive-yield control; neither behavior transferred after two distinct E0b acquisition updates."
  },
  "principle": "Deliberately leak solution-relevant interaction structure early to grow capability, then tighten one independent boundary at a time while preserving the complementary leak. Leakage is curriculum support, not a defect or a disqualifier.",
  "spade_alignment": {
    "source": "2608.19197v1.pdf, Figure 8 and surrounding discussion",
    "reported_solution_method_reveal_schedule": {
      "early_percent": 25,
      "mid_percent": 10,
      "late_percent": 5
    },
    "local_analogue": "E0c2 -> E0c25 -> E0c3 progressively removes child evidence and action supports only after the supported behavior is acquired; yield supports are tightened independently.",
    "policy": "Early supported successes remain valid capability-growing data when they satisfy the preregistered phase audit. Advancement, rather than retroactive punishment, removes the leak."
  },
  "prospective_rungs": [
    {
      "phase": "E0c_child_naturalization",
      "purpose": "Measure and acquire unconstrained child reporting without exposing coordinator yield failures.",
      "retained_help": [
        "exact retained root spawn",
        "exact structured passive yield",
        "one terminal child-closing response after a valid send"
      ],
      "removed_help": "numeric child-send regex",
      "replacement_leak": "The hidden child evidence message explicitly states that the evidence label is not a file path and supplies a value-agnostic send-code template; the first tool is forced to IPython but its code is model-generated.",
      "qualification": "A complete hard success must contain a sampled, unconstrained child IPython call whose AST sends the correct inline-evidence value exactly once to the parent."
    },
    {
      "phase": "E0d_yield_naturalization",
      "purpose": "Measure and acquire native passive yield without exposing child reporting failures.",
      "retained_help": [
        "exact retained root spawn",
        "value-agnostic pattern-constrained child send",
        "one terminal child-closing response"
      ],
      "removed_help": "single-choice exact waiting sentence",
      "replacement_leak": "The post-spawn observation gives a generic yield instruction, removes tools, disables thinking, and caps the transition, but the waiting text itself is generated without a response-choice constraint.",
      "qualification": "A complete hard success must contain one sampled no-tool coordinator response before the child report."
    }
  ],

[Unit]
Description=Zero-update first-response token alignment audit for thinking Qwen 3.5 27B
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CUDA_VISIBLE_DEVICES=2,3
ExecStart=/bin/bash /home/ubuntu/prime-rl/scripts/run_qwen35_27b_first_response_token_audit.sh
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/253-qwen35-27b-first-response-token-audit.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/253-qwen35-27b-first-response-token-audit.log

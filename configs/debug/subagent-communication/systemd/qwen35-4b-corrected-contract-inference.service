[Unit]
Description=Qwen 3.5 4B inference for corrected-contract screens
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/uv run inference @ configs/debug/subagent-communication/199-qwen35-4b-corrected-contract-inference.toml
Restart=on-failure
RestartSec=5
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/199-qwen35-4b-corrected-contract-inference.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/199-qwen35-4b-corrected-contract-inference.log

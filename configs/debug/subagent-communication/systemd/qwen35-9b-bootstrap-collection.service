[Unit]
Description=Collect strict Qwen 3.5 9B subagent bootstrap trajectories
After=qwen35-9b-base-inference.service
Requires=qwen35-9b-base-inference.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/uv run eval @ configs/debug/subagent-communication/190-qwen35-9b-inert-bootstrap-collection.toml
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/190-qwen35-9b-inert-bootstrap-collection.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/190-qwen35-9b-inert-bootstrap-collection.log

[Unit]
Description=Untouched Qwen 3.5 27B Prime Agent smoke screens
After=qwen35-27b-teacher-inference.service
Requires=qwen35-27b-teacher-inference.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/prime-rl/scripts/run_qwen35_27b_teacher_smokes.sh
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/212-213-qwen35-27b-teacher-smokes.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/212-213-qwen35-27b-teacher-smokes.log

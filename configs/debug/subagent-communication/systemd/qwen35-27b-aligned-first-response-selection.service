[Unit]
Description=Paired selection for aligned Qwen 3.5 27B first-response OPSD
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /home/ubuntu/prime-rl/scripts/run_qwen35_27b_aligned_first_response_selection.sh
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/255-qwen35-27b-aligned-first-response-selection.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/255-qwen35-27b-aligned-first-response-selection.log

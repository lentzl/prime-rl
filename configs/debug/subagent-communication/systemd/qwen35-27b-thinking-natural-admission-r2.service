[Unit]
Description=Corrected natural bidirectional admission for untouched thinking Qwen 3.5 27B
After=qwen35-27b-teacher-inference.service
Requires=qwen35-27b-teacher-inference.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/uv run eval @ configs/debug/subagent-communication/229-qwen35-27b-thinking-natural-admission-r2.toml --output-dir /ephemeral/subagent-rung/evals/229-qwen35-27b-thinking-natural-admission-r2/base
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/229-qwen35-27b-thinking-natural-admission-r2.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/229-qwen35-27b-thinking-natural-admission-r2.log

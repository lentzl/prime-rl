[Unit]
Description=Two-GPU Qwen 3.5 27B teacher inference
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CUDA_VISIBLE_DEVICES=0,1
ExecStart=/bin/bash -lc 'export HF_TOKEN="$HF_KEY"; exec /home/ubuntu/prime-rl/.venv/bin/inference @ configs/debug/subagent-communication/211-qwen35-27b-teacher-inference.toml'
Restart=on-failure
RestartSec=5
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/211-qwen35-27b-teacher-inference.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/211-qwen35-27b-teacher-inference.log

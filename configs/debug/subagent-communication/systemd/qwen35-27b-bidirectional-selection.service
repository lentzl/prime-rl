[Unit]
Description=Screen focused Qwen 3.5 27B bidirectional checkpoints
After=qwen35-27b-bidirectional-sft.service qwen35-27b-teacher-inference.service
Requires=qwen35-27b-teacher-inference.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/prime-rl/scripts/run_qwen35_27b_bidirectional_selection.sh
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/222-qwen35-27b-bidirectional-selection.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/222-qwen35-27b-bidirectional-selection.log

[Unit]
Description=First-response OPSD for the accepted Qwen 3.5 4B checkpoint
After=qwen35-4b-clean-causal-preflight.service qwen35-4b-executable-causal-inference.service
Requires=qwen35-4b-executable-causal-inference.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/uv run rl @ configs/debug/subagent-communication/209-qwen35-4b-first-response-opsd.toml
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/209-qwen35-4b-first-response-opsd-r2.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/209-qwen35-4b-first-response-opsd-r2.log

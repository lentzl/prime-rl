[Unit]
Description=Paired selection for Qwen 3.5 27B first-coordinator OPSD
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /home/ubuntu/prime-rl/scripts/run_qwen35_27b_first_coordinator_opsd_selection.sh
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/241-qwen35-27b-first-coordinator-opsd-selection.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/241-qwen35-27b-first-coordinator-opsd-selection.log

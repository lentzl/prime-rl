[Unit]
Description=Qwen 3.5 9B teacher inference for subagent communication experiments
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/uv run inference @ configs/debug/subagent-communication/160-qwen35-9b-clean-message-lora-inference.toml
Restart=on-failure
RestartSec=5
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/189-qwen35-9b-systemd-inference.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/189-qwen35-9b-systemd-inference.log

[Install]
WantedBy=default.target

[Unit]
Description=Train the Qwen 3.5 9B turn-ending teacher bootstrap adapter

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/uv run sft @ configs/debug/subagent-communication/192-qwen35-9b-turn-ending-bootstrap-sft.toml
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/192-qwen35-9b-turn-ending-bootstrap-sft.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/192-qwen35-9b-turn-ending-bootstrap-sft.log

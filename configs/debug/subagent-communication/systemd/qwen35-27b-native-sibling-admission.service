[Unit]
Description=Qwen3.5-27B native sibling ownership admission
After=network-online.target qwen35-27b-teacher-inference.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
ExecStart=/home/ubuntu/prime-rl/.venv/bin/eval @ configs/debug/subagent-communication/259-qwen35-27b-native-sibling-admission.toml
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/259-qwen35-27b-native-sibling-admission.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/259-qwen35-27b-native-sibling-admission.log

[Install]
WantedBy=default.target

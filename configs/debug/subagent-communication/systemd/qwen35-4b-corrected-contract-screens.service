[Unit]
Description=Compare Qwen 3.5 4B corrected-contract checkpoints
After=qwen35-4b-corrected-contract-inference.service
Requires=qwen35-4b-corrected-contract-inference.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/prime-rl/scripts/run_qwen35_4b_corrected_contract_screens.sh
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/200-qwen35-4b-corrected-contract-screens.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/200-qwen35-4b-corrected-contract-screens.log

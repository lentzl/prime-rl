[Unit]
Description=Paired unguided first-decision selection for native ownership SFT
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /home/ubuntu/prime-rl/scripts/run_qwen35_27b_native_ownership_selection.sh
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/252-qwen35-27b-native-ownership-selection.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/252-qwen35-27b-native-ownership-selection.log

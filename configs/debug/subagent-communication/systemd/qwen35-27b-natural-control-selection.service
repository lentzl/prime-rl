[Unit]
Description=Paired natural-control selection for thinking Qwen 3.5 27B
After=qwen35-27b-teacher-inference.service
Requires=qwen35-27b-teacher-inference.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/prime-rl
EnvironmentFile=/home/ubuntu/prime-rl/.env
Environment=PATH=/home/ubuntu/prime-rl/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /home/ubuntu/prime-rl/scripts/run_qwen35_27b_natural_control_selection.sh
StandardOutput=append:/ephemeral/subagent-rung/launch-logs/233-qwen35-27b-natural-control-selection.log
StandardError=append:/ephemeral/subagent-rung/launch-logs/233-qwen35-27b-natural-control-selection.log
